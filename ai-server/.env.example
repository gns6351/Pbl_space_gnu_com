# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 GitHub에 올라가지 않습니다(키를 커밋하지 마세요).

# Gemini API 키 (Google AI Studio). 비워 두면 모의(mock) 모드로 동작 — 앱 화면 개발은 키 없이도 됩니다
GEMINI_API_KEY=
# live: 실제 호출 / mock: 가짜 응답 (비워 두면 키가 있을 때 live)
LLM_MODE=

# 게임 모델(손님 생성·손님 대사·조언 판정·자기 지향 변환·위험 판정)
GAME_MODEL=gemini-3.5-flash-lite
# 변환 점검 모델. 변환 모델과 다른 모델 권장. 비우면 GAME_MODEL
GAME_CHECK_MODEL=gemini-3.5-flash
# 테스트 도구(npm run sim)의 가상 플레이어 모델. 비우면 GAME_MODEL
SIM_MODEL=gemini-3.1-flash-lite
# 추론 강도: low / medium / high. 모델이 지원하지 않으면 자동으로 빼고 보냄. 비우면 모델 기본값
GEMINI_THINKING_LEVEL=low

# AI 호출 1회 시간 제한(ms). NFR-01 일반 턴 p95 10초
GAME_TIMEOUT_MS=9000
# 거울 장면(변환·점검, 최대 4회) 호출 1회 시간 제한(ms). 4회 × 5초 = 20초
GAME_MIRROR_TIMEOUT_MS=5000
# 프롬프트 버전 (content/prompts/<종류>/<버전>.md)
GAME_PROMPT_VERSION=v1

# 비워 두면 3000부터 빈 포트를 찾아 씀
PORT=
# 세션·카드·로그·보고서가 쌓이는 폴더 (GitHub에 올라가지 않음)
DATA_DIR=data
